# Copiar como .env y completar antes de correr en producción.
# En desarrollo local, los valores por defecto en application.properties alcanzan.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/turnos_medicos
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

SERVER_PORT=8081

# Generar una clave real de al menos 256 bits para producción, nunca reutilizar esta.
JWT_SECRET=cambiar_por_clave_secreta_de_al_menos_256_bits_en_produccion
JWT_EXPIRATION_MS=86400000
